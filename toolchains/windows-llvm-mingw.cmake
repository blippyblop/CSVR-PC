set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CSVR_LLVM_MINGW "$ENV{CSVR_LLVM_MINGW}" CACHE PATH "LLVM-MinGW root")
if(NOT EXISTS "${CSVR_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang")
  message(FATAL_ERROR "Set CSVR_LLVM_MINGW to your LLVM-MinGW toolchain")
endif()
set(CMAKE_C_COMPILER "${CSVR_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${CSVR_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${CSVR_LLVM_MINGW}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${CSVR_LLVM_MINGW}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
